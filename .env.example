# Never use the local demo tokens outside development.
NODE_ENV=development
EMBERLINE_OWNER_TOKEN=replace-with-a-long-random-token
EMBERLINE_IMPLEMENTER_TOKEN=replace-with-a-long-random-token
EMBERLINE_TECHNICAL_TOKEN=replace-with-a-long-random-token
EMBERLINE_STAKEHOLDER_TOKEN=replace-with-a-long-random-token
EMBERLINE_AUDITOR_TOKEN=replace-with-a-long-random-token
EMBERLINE_TECHNICAL_WALLET=
EMBERLINE_STAKEHOLDER_WALLET=
EMBERLINE_AUDITOR_WALLET=
EMBERLINE_DB_PATH=./data/emberline.db
ALLOW_LOCAL_ATTESTATIONS=true

# Attestcoin Protocol / Creditcoin configuration.
# Local mode remains usable without these values.
ATTESTCOIN_MODE=unconfigured
ATTESTCOIN_NETWORK=Creditcoin USC testnet
ATTESTCOIN_CHAIN_ID=102031
ATTESTCOIN_SOURCE_CHAIN=Ethereum Sepolia
ATTESTCOIN_SOURCE_CHAIN_KEY=1
ATTESTCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/
ATTESTCOIN_SOURCE_REGISTRY=
ATTESTCOIN_DECODER_CONTRACT=0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f
ATTESTCOIN_USC_CONTRACT=
